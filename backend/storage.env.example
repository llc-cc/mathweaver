# Host-local backend values for compose.db.local.yml
DATABASE_URL=mysql+pymysql://mathweaver:mathweaver-local-only@127.0.0.1:3306/mathweaver?charset=utf8mb4
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD_FILE=C:/replace/with/neo4j-password.txt
MATHWEAVER_DATA_KEY_FILE=C:/replace/with/mathweaver-data-key.txt
MATHGRAPH_DATA_DIR=D:/replace/with/mathweaver-data

# When the API is later containerized on the production database network, use:
# DATABASE_URL=mysql+pymysql://mathweaver:<url-encoded-password>@mysql:3306/mathweaver?charset=utf8mb4
# NEO4J_URI=neo4j://neo4j:7687
# NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password
# MATHWEAVER_DATA_KEY_FILE=/run/secrets/mathweaver_data_key
