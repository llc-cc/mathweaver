[Unit]
Description=MathWeaver teaching frontend sidecar
After=network.target

[Service]
Type=simple
User=nginx
Group=nginx
WorkingDirectory=/opt/mathweaver/current-teaching
Environment=HOST=127.0.0.1
Environment=PORT=5174
ExecStart=/opt/mathweaver/current-teaching/.runtime/node /opt/mathweaver/current-teaching/node_modules/@react-router/serve/bin.js ./build/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
