[Unit]
Description=MathWeaver isolated long-running pipeline coordinator
After=network.target mysql.service
PartOf=mathweaver-teaching-backend.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nginx
Group=nginx
WorkingDirectory=/opt/mathweaver/current-teaching/backend
EnvironmentFile=/opt/mathweaver/.env.teaching
Environment=LLM_HTTP_CONNECT_TIMEOUT=10
Environment=LLM_HTTP_TIMEOUT=120
Environment=MATHWEAVER_RUNTIME_DIR=/run/mathweaver
RuntimeDirectory=mathweaver
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/opt/mathweaver/current-teaching/.venv/bin/gunicorn --bind 127.0.0.1:5004 --worker-class gthread --workers 1 --threads 4 --backlog 32 --timeout 330 --graceful-timeout 60 --keep-alive 2 --access-logfile - --error-logfile - api_v2:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
PrivateTmp=true
NoNewPrivileges=true
LimitNOFILE=65536
TasksMax=384
CPUWeight=75
MemoryHigh=3G
MemoryMax=4G
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
