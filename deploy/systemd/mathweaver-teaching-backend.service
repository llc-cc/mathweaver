[Unit]
Description=MathWeaver teaching backend sidecar
After=network.target mysql.service

[Service]
Type=simple
User=nginx
Group=nginx
WorkingDirectory=/opt/mathweaver/current-teaching/backend
EnvironmentFile=/opt/mathweaver/.env.teaching
ExecStart=/opt/mathweaver/current-teaching/.venv/bin/gunicorn --bind 127.0.0.1:5002 --workers 2 --threads 2 --timeout 180 --access-logfile - --error-logfile - api_v2:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
