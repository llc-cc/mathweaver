[Unit]
Description=Back up MathWeaver MySQL, Neo4j graphs, and persistent files
After=network-online.target mathweaver-neo4j.service
Wants=network-online.target mathweaver-neo4j.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/mathweaver/current-teaching/scripts/backup_teaching_data.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
UMask=0077
