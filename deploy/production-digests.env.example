# Resolve and review these manifest-list digests in the deployment environment.
# Production Compose refuses to start when either value is missing.
MYSQL_IMAGE_DIGEST=sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb
NEO4J_IMAGE_DIGEST=sha256:dbc377fb9cd8fe8dabc19d3041b197d5ca0ef8bae514cea175b8df265e5b7a76
MYSQL_APP_PASSWORD_FILE=/run/mathweaver-secrets/mysql_app_password
MYSQL_ROOT_PASSWORD_FILE=/run/mathweaver-secrets/mysql_root_password
# File content must be: neo4j/<password>
NEO4J_AUTH_SECRET_FILE=/run/mathweaver-secrets/neo4j_auth
# Password-only file consumed by the future API container via NEO4J_PASSWORD_FILE.
NEO4J_PASSWORD_SECRET_FILE=/run/mathweaver-secrets/neo4j_password
MATHWEAVER_DATA_KEY_SECRET_FILE=/run/mathweaver-secrets/mathweaver_data_key
