{
  "name": "optui",
  "version": "0.1.1",
  "description": "MathWeaver desktop research build",
  "author": "AI4Math Lab",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "react-router build",
    "build:desktop": "set DESKTOP_SPA=1&& set VITE_API_ORIGIN=__SAME_ORIGIN__&& react-router build",
    "dev": "react-router dev",
    "dev:demo": "DEMO=1 react-router dev",
    "desktop:dev": "electron .",
    "dist:win": "electron-builder --config electron-builder.json --win",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test:ocr-state": "vitest run app/ocr.test.ts",
    "test:auth": "vitest run app/routes/auth-model.test.ts app/routes/AuthModal.test.tsx app/routes/PasswordChangeModal.test.tsx app/routes/home-auth-gate.test.tsx app/context/jobs-auth.test.tsx app/routes/PdfSourceViewer.auth.test.tsx app/routes/studio-export-auth.test.tsx app/routes/ProofWorkspace.storage.test.tsx"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@matejmazur/react-katex": "^3.1.3",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "isbot": "^5.1.31",
    "katex": "^0.16.27",
    "lucide-react": "^1.17.0",
    "neo4j-driver": "^6.0.1",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-katex": "^3.1.0",
    "react-router": "^7.9.2",
    "vis-data": "^8.0.4",
    "vis-network": "^10.0.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
}
