# 复制为未纳入版本控制的 .env.production，并只在服务器填写真实值。
# 目标必须是独立的 mathweaver 数据库，禁止指向其他业务库。
MATHWEAVER_DATABASE_URL=
MATHWEAVER_DATABASE_NAME=mathweaver
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD_FILE=/opt/mathweaver/secrets/neo4j_password
MATHWEAVER_DATA_KEY_FILE=/opt/mathweaver/secrets/mathweaver_data_key
MATHGRAPH_DATA_DIR=/opt/mathweaver/data

MATHWEAVER_SESSION_TTL_SECONDS=604800
MATHWEAVER_ALLOWED_ORIGINS=
MATHWEAVER_BACKEND_PORT=5002
MATHWEAVER_FRONTEND_PORT=5174

# Bounded concurrency keeps synchronous AI and long pipelines from exhausting
# the host. Capacity is shared across every local backend process.
MATHWEAVER_AI_MAX_ACTIVE=4
MATHWEAVER_PIPELINE_MAX_ACTIVE=2
MATHWEAVER_CAPACITY_RETRY_AFTER_SECONDS=5
MATHWEAVER_PIPELINE_LLM_THREADS=4
MATHWEAVER_PIPELINE_CHECKPOINT_INTERVAL=10
MATHWEAVER_JOB_MEMORY_TTL_SECONDS=3600
MATHWEAVER_MAX_REQUEST_BYTES=125829120

# Keep database connections bounded during bursts.
MATHWEAVER_DB_POOL_SIZE=4
MATHWEAVER_DB_MAX_OVERFLOW=4
MATHWEAVER_DB_POOL_TIMEOUT=10

# LLM 凭据仅由后端运行环境注入，不得作为前端构建参数。
PDFPIPELINE_API_URL=
PDFPIPELINE_API_KEY=
PDFPIPELINE_MODEL_NAME=
PDFPIPELINE_EMBEDDING_API_URL=
PDFPIPELINE_EMBEDDING_API_KEY=
PDFPIPELINE_EMBEDDING_MODEL=
