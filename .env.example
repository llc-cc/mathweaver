# 复制为未纳入版本控制的 .env.production，并只在服务器上填写真实值。
# 必填；目标必须是独立的 mathweaver 数据库，禁止指向 uniprism_alphatest_user。
# 格式：mysql+pymysql://mathweaver_app:<URL编码后的密码>@<RDS内网地址>:3306/mathweaver?charset=utf8mb4
MATHWEAVER_DATABASE_URL=
MATHWEAVER_DATABASE_NAME=mathweaver

MATHWEAVER_SESSION_TTL_SECONDS=604800
# 同源部署保持为空；只有确需跨域访问时才填写逗号分隔的完整 Origin。
MATHWEAVER_ALLOWED_ORIGINS=
MATHWEAVER_HTTP_PORT=8080

# 本地开发默认使用 local；生产 Compose 会强制覆盖为 oss 并在配置不完整时拒绝启动。
MATHWEAVER_OBJECT_STORAGE=local
MATHWEAVER_OSS_ENDPOINT=
MATHWEAVER_OSS_BUCKET=
MATHWEAVER_OSS_ACCESS_KEY_ID=
MATHWEAVER_OSS_ACCESS_KEY_SECRET=
MATHWEAVER_OSS_PREFIX=mathweaver/

# 模型凭据认证加密密钥；只通过后端 secret 注入，生产环境必须配置。
MATHWEAVER_CREDENTIAL_KEYS_JSON=
MATHWEAVER_CREDENTIAL_ACTIVE_KEY_ID=

# 容量与保留边界；生产部署必须按压测和 RDS max_allowed_packet 结果填写。
MATHWEAVER_MAX_UPLOAD_BYTES=
MATHWEAVER_MAX_TASK_FILES=
MATHWEAVER_MAX_TASK_BYTES=
MATHWEAVER_MAX_NODES=
MATHWEAVER_MAX_EDGES=
MATHWEAVER_MAX_HISTORY_JSON_BYTES=
MATHWEAVER_MAX_USER_HISTORY_BYTES=
MATHWEAVER_HISTORY_RETENTION_DAYS=
MATHWEAVER_MIN_FREE_DISK_BYTES=

# 仅绑定容器内部网络，不经公网 Nginx 代理。
MATHWEAVER_METRICS_BIND=

# 镜像标签用于可重复发布和回滚；生产环境不要使用 latest。
MATHWEAVER_FRONTEND_IMAGE=mathweaver-web:local
MATHWEAVER_BACKEND_IMAGE=mathweaver-backend:local
# 迁移镜像独立保留，应用回滚时不能随 backend 标签盲目回退。
MATHWEAVER_MIGRATION_IMAGE=mathweaver-backend:local

# 模型配置只在运行时注入后端，绝不能作为前端构建参数。
PDFPIPELINE_API_URL=
PDFPIPELINE_API_KEY=
PDFPIPELINE_MODEL_NAME=
PDFPIPELINE_EMBEDDING_API_URL=
PDFPIPELINE_EMBEDDING_API_KEY=
PDFPIPELINE_EMBEDDING_MODEL=
